# 复制为 .env 并填写密钥；两套配置完全独立。
# 默认选择 OpenAI Images 协议，首次仅在用户明确指定时选择 Gemini 协议。
# 示例为同时支持两种协议的 Skillsvc 网关；可替换为官方地址或其他兼容网关。
# 每套地址、密钥、模型 ID 和认证方式须对应同一服务商；进程环境变量优先于本文件。
OPENAI_API_BASE_URL=https://www.skillsvc.cc
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2

GEMINI_API_BASE_URL=https://www.skillsvc.cc
GEMINI_API_KEY=
GEMINI_MODEL=nana-banana-2

# 认证方式可选 bearer 或 x-goog-api-key；默认均为 bearer。
# OPENAI_API_AUTH=bearer
# GEMINI_API_AUTH=x-goog-api-key

# 可选能力配置。注释中是默认值；OPENAI_DEFAULT_SIZE 是精确尺寸示例。
# OPENAI_DEFAULT_ASPECT_RATIO=16:9
# OPENAI_DEFAULT_IMAGE_SIZE=2K
# OPENAI_DEFAULT_SIZE=2048x1152
# OPENAI_DEFAULT_OUTPUT_FORMAT=png
# OPENAI_DEFAULT_QUALITY=auto
# OPENAI_SUPPORTED_FORMATS=png,jpeg,webp
# OPENAI_SUPPORTED_QUALITIES=auto,low,medium,high
# OPENAI_MAX_INPUT_IMAGE_MB=4

# GEMINI_DEFAULT_ASPECT_RATIO=16:9
# GEMINI_DEFAULT_IMAGE_SIZE=2K
# GEMINI_DEFAULT_OUTPUT_FORMAT=png
# GEMINI_DEFAULT_QUALITY=auto
# GEMINI_SUPPORTED_FORMATS=png
# GEMINI_SUPPORTED_QUALITIES=auto
# GEMINI_MAX_INPUT_IMAGE_MB=4
